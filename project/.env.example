# ============ 应用基础配置 ============
NODE_ENV=development
PORT=3000

# ============ 数据库 ============
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=videouser
DB_PASSWORD=videopass
DB_DATABASE=videoflow

# ============ Redis ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ JWT 认证 ============
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ============ OpenAI / AI 模型 ============
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ============ 各平台 API 密钥 ============
# 抖音开放平台
DOUYIN_CLIENT_ID=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=http://localhost:3000/api/platform/callback/douyin

# B站
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=
BILIBILI_REDIRECT_URI=http://localhost:3000/api/platform/callback/bilibili

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/platform/callback/youtube

# 快手
KUAISHOU_CLIENT_ID=
KUAISHOU_CLIENT_SECRET=
KUAISHOU_REDIRECT_URI=http://localhost:3000/api/platform/callback/kuaishou

# 视频号
WEIXIN_CLIENT_ID=
WEIXIN_CLIENT_SECRET=
WEIXIN_REDIRECT_URI=http://localhost:3000/api/platform/callback/weixin

# TikTok
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/platform/callback/tiktok

# ============ 文件上传 ============
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500

# ============ 前端地址（CORS） ============
FRONTEND_URL=http://localhost:5173
